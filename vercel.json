{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd drs && npm install",
  "buildCommand": "cd drs && npm run build",
  "outputDirectory": "drs/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
