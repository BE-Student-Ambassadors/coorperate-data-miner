# Google Gemini API Key for Gemini 3.8 Flash & Antigravity Agent Web Scraping
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=


# Completion emails for background fetches are sent from this Gmail account.
# NOTIFY_EMAIL_APP_PASSWORD is a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords),
# not the account's normal password. Without it, fetches still run but no email is sent.
NOTIFY_EMAIL_FROM=besabreak@gmail.com
NOTIFY_EMAIL_APP_PASSWORD=
# Optional link to the app included in the email, e.g. https://your-app.vercel.app
APP_URL=
